class TechnicalEmployee extends Employee {
    private double basicSalary;
    private int rating;

    TechnicalEmployee(String name, double salary, int rating) {
        super(name);
        basicSalary = salary;
        this.rating = rating;
    }

    @Override
    double calculateBonus() {
        return basicSalary * rating * 2 / 100;
    }

    double calculateBonus(double salary, int employeeRating) {
        return salary * employeeRating * 2 / 100;
    }

    double getTotalEarnings() {
        return basicSalary + calculateBonus();
    }
}
class SalesEmployee extends Employee {
    private double salesAmount;

    SalesEmployee(String name, double amount) {
        super(name);
        salesAmount = amount;
    }

    @Override
    double calculateBonus() {
        return calculateBonus(salesAmount);
    }

    @Override
    double calculateBonus(double amount) {
        return amount * 3 / 100;
    }

    double getTotalEarnings() {
        return salesAmount + calculateBonus();
    }
}
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int employeeType = sc.nextInt();
        String name = sc.next();

        Employee emp;
        double bonus;
        double total;

        if (employeeType == 1) {
            double salary = sc.nextDouble();
            int rating = sc.nextInt();

            TechnicalEmployee tech =
                    new TechnicalEmployee(name, salary, rating);

            emp = tech;
            bonus = emp.calculateBonus();
            total = tech.getTotalEarnings();
        } else {
            double amount = sc.nextDouble();

            SalesEmployee sales =
                    new SalesEmployee(name, amount);

            emp = sales;
            bonus = emp.calculateBonus();
            total = sales.getTotalEarnings();
        }

        System.out.println("Employee Name: " + name);
        System.out.printf("Bonus: %.2f%n", bonus);
        System.out.printf("Total Earnings: %.2f%n", total);

        sc.close();
    }
}
